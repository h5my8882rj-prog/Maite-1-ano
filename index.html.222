<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>A Magia de Maitê • RSVP</title>

<meta property="og:type" content="website">
<meta property="og:title" content="A Magia de Maitê ✨">
<meta property="og:description" content="Abra a porta para entrar na magia e confirme sua presença.">
<meta property="og:url" content="https://h5my8882rj-prog.github.io/Maite-1-ano/">
<meta property="og:image" content="https://h5my8882rj-prog.github.io/Maite-1-ano/capa-maite.png">
<meta property="og:image:secure_url" content="https://h5my8882rj-prog.github.io/Maite-1-ano/capa-maite.png">
<meta property="og:image:type" content="image/png">
<meta property="og:image:alt" content="A Magia de Maitê - convite de 1 ano">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="A Magia de Maitê ✨">
<meta name="twitter:description" content="Abra a porta para entrar na magia e confirme sua presença.">
<meta name="twitter:image" content="https://h5my8882rj-prog.github.io/Maite-1-ano/capa-maite.png">

<style>
:root{--pink:#e7a6bf;--pink2:#f7dce6;--gold:#d8b26a;--cream:#fffaf6;--text:#7b5868}
*{box-sizing:border-box}
body{margin:0;font-family:Arial,sans-serif;color:var(--text);background:linear-gradient(180deg,#f7dce6,#f9eee4 65%,#fff);min-height:100vh;padding:20px 12px}
.wrap{max-width:720px;margin:auto}
.hero{border-radius:28px 28px 0 0;padding:34px 18px 80px;text-align:center;background:radial-gradient(circle at 20% 15%,#fff8,transparent 22%),radial-gradient(circle at 82% 18%,#fff7,transparent 18%),linear-gradient(160deg,#8ea5e9,#e7a6bf 55%,#f4c7d7);color:white;box-shadow:0 18px 40px #9d68843a;position:relative;overflow:hidden}
.hero:before{content:"✨  ✦  ✨";position:absolute;top:20px;left:0;right:0;font-size:26px;opacity:.8}
.hero h1{font:32px Georgia,serif;margin:24px 0 0;text-shadow:0 2px 10px #85586c55}
.hero .maite{font:62px "Brush Script MT","Segoe Script",cursive;color:#fff1d6;line-height:.9}
.hero p{margin:12px 0 0;font-weight:700}
.shell{margin-top:-55px;position:relative;padding:0 12px 22px}
.monogram{width:96px;height:96px;border-radius:50%;margin:auto;display:grid;place-items:center;background:linear-gradient(#efbfd0,#d88fa8);color:white;border:5px solid white;font:bold 42px Georgia,serif;box-shadow:0 12px 28px #9a5e7a33}
.card{background:#fffdfc;border:2px solid #e8d2a8;border-radius:28px;padding:22px;box-shadow:0 16px 38px #9a688320}
h2{text-align:center;font:30px Georgia,serif;margin:0;color:#8b6073}
.intro{text-align:center;line-height:1.5;color:#9a7485;margin:8px auto 18px;max-width:520px}
.line{width:130px;height:4px;background:linear-gradient(90deg,transparent,var(--gold),transparent);margin:0 auto 20px}
label{display:block;font-weight:800;font-size:14px;margin:0 0 7px}
input,select{width:100%;padding:14px 15px;border:1.5px solid #e3bdcb;border-radius:16px;background:white;color:#684957;font-size:16px;outline:none}
input:focus,select:focus{border-color:#d88fa8;box-shadow:0 0 0 4px #d88fa82c}
.field{margin-bottom:15px}
.btn{width:100%;padding:16px;border:0;border-radius:18px;background:linear-gradient(90deg,#d88fa8,#eab3c6,#d8b26a);color:white;font-weight:900;font-size:17px;cursor:pointer}
.btn.secondary{background:white;color:#a46880;border:1.5px solid #e2b8c7;margin-top:9px}
.hidden{display:none!important}
.msg{padding:12px 14px;border-radius:14px;margin:12px 0;font-size:14px;line-height:1.4}
.error{background:#fff0f2;color:#a65363;border:1px solid #efc4cb}
.party{margin-top:18px;padding:16px;border-radius:20px;border:1.5px dashed #dca3b8;background:#fff9fb}
.party h3{margin:0 0 10px}
.person{padding:10px 7px;border-bottom:1px solid #f0dce4}
.person:last-child{border-bottom:0}
.head{display:flex;align-items:center;gap:10px}
.head input{width:20px;height:20px;accent-color:#d88fa8}
.badge{margin-left:auto;padding:4px 8px;border-radius:99px;background:#f6e9ef;font-size:11px}
.age{margin:9px 0 0 30px}
.limit{margin-top:16px;padding:15px;border-radius:18px;background:#fbf2e7;border:1px solid #ead5ae}
.two{display:grid;grid-template-columns:2fr 1fr;gap:10px}
.success{text-align:center;padding:16px 4px}
.check{width:70px;height:70px;border-radius:50%;display:grid;place-items:center;margin:auto;background:#d88fa8;color:white;font-size:36px;font-weight:bold}
.success h3{font:28px Georgia,serif;margin:14px 0 8px}


.cover-screen{
  min-height:100vh;
  display:flex;
  align-items:center;
  justify-content:center;
  padding:0;
  background:#f7dce6;
}
.cover-wrap{
  position:relative;
  width:min(100vw,720px);
  margin:auto;
  line-height:0;
}
.cover-wrap img{
  display:block;
  width:100%;
  height:auto;
}
.castle-door-hotspot{
  position:absolute;
  left:42.3%;
  top:72.2%;
  width:15.8%;
  height:13.2%;
  border:0;
  background:transparent;
  cursor:pointer;
  border-radius:45% 45% 18% 18%;
  padding:0;
}
.castle-door-hotspot:focus-visible{
  outline:4px solid rgba(255,255,255,.9);
  box-shadow:0 0 0 7px rgba(216,143,168,.75);
}
.door-label{
  position:absolute;
  left:50%;
  bottom:5.2%;
  transform:translateX(-50%);
  width:86%;
  text-align:center;
  font:700 18px Georgia,serif;
  color:#fff7e8;
  text-shadow:0 2px 10px rgba(63,39,62,.85);
  line-height:1.2;
  z-index:30;
  pointer-events:none;
}
.door-hint{
  display:block;
  margin-top:5px;
  font:600 13px Arial,sans-serif;
  opacity:.95;
}

.video-intro{
  max-width:720px;
  margin:auto;
  text-align:center;
}
.video-frame{
  background:#000;
  border-radius:28px;
  overflow:hidden;
  box-shadow:0 18px 40px #9d68843a;
}
.video-frame video{
  display:block;
  width:100%;
  height:auto;
  max-height:90vh;
  background:#000;
}
.video-note{
  margin:14px 0 0;
  color:#8b6073;
  font-size:14px;
}
#rsvpApp.hidden-app{
  display:none;
}

@media(max-width:560px){.hero .maite{font-size:52px}.card{padding:18px}.two{grid-template-columns:1fr}}




@media(max-width:560px){
.door-label{
    left:50.2% !important;
    right:auto !important;
    width:58% !important;
    bottom:5.9% !important;
    transform:translateX(-50%) !important;
    font-family:"Palatino Linotype","Book Antiqua",Palatino,Georgia,serif !important;
    font-size:16px !important;
    font-style:italic !important;
    font-weight:600 !important;
    color:#5f3b20 !important;
    text-shadow:
      0 1px 0 rgba(255,241,214,.90),
      0 2px 3px rgba(72,39,18,.48),
      0 3px 7px rgba(72,39,18,.28) !important;
    line-height:1.16 !important;
    letter-spacing:.003em !important;
    text-align:center !important;
    z-index:30 !important;
    padding:0 !important;
    margin:0 !important;
  }

  .door-arrow{
    display:block !important;
    width:100% !important;
    font-size:19px !important;
    line-height:1 !important;
    margin:0 0 3px 0 !important;
    text-align:center !important;
    color:#9a6737 !important;
  }
}


/* AJUSTE FINAL DA FRASE - força cor e sombra */
.door-label{
  color:#5a351d !important;
  text-shadow:
    0 1px 0 rgba(255,238,206,.82),
    0 2px 3px rgba(65,34,16,.55),
    0 4px 8px rgba(65,34,16,.32) !important;
}

@media(max-width:560px){
  .door-label{
    color:#5a351d !important;
    bottom:5.9% !important;
    text-shadow:
      0 1px 0 rgba(255,238,206,.82),
      0 2px 3px rgba(65,34,16,.55),
      0 4px 8px rgba(65,34,16,.32) !important;
  }
  .door-arrow{
    color:#6f451f !important;
    text-shadow:
      0 1px 0 rgba(255,238,206,.75),
      0 2px 4px rgba(65,34,16,.35) !important;
  }
}


/* AJUSTE FINAL DA SETA */
.door-label{
  position:absolute !important;
}

.door-arrow{
  display:block !important;
  position:relative !important;
  left:0 !important;
  width:100% !important;
  text-align:center !important;
  font-size:22px !important;
  line-height:1 !important;
  margin:0 0 8px 0 !important;
  color:#6f451f !important;
  text-shadow:
    0 1px 0 rgba(255,238,206,.78),
    0 2px 4px rgba(65,34,16,.38) !important;
}

@media(max-width:560px){
  .door-label{
    left:50.2% !important;
    transform:translateX(-50%) !important;
  }
  .door-arrow{
    font-size:21px !important;
    margin-bottom:7px !important;
  }
}


@media(max-width:560px){
  body{
    padding:0 !important;
    background:#f7dce6 !important;
  }

  .cover-screen{
    min-height:auto !important;
    padding-top:28px !important;
    padding-bottom:0 !important;
    display:block !important;
    background:#f7dce6 !important;
  }

  .cover-wrap{
    width:100vw !important;
    max-width:none !important;
    margin:0 !important;
  }

  .cover-wrap img{
    display:block !important;
    width:100% !important;
    height:auto !important;
  }
}




@media(max-width:560px){
  
}


/* POSICIONAMENTO FINAL DA FRASE NA BASE DA PRIMEIRA TELA */
.cover-screen{
  position:relative !important;
}


}


/* LAYOUT FINAL DA CAPA: imagem em cima, frase abaixo */
.cover-screen{
  display:block !important;
  min-height:auto !important;
  padding:0 !important;
  background:#f7dce6 !important;
  overflow:visible !important;
}

.cover-wrap{
  width:min(100%,720px) !important;
  max-width:720px !important;
  margin:0 auto !important;
  position:relative !important;
}

.cover-wrap img{
  display:block !important;
  width:100% !important;
  height:auto !important;
}



@media(max-width:560px){
  .cover-wrap{
    width:100vw !important;
    max-width:none !important;
  }

  
}


/* FRASE DENTRO DA ARTE */
.cover-wrap{
  position:relative !important;
}

.door-label{
  position:absolute !important;
  left:50% !important;
  bottom:2.2% !important;
  transform:translateX(-50%) !important;
  width:72% !important;
  text-align:center !important;
  font-family:"Palatino Linotype","Book Antiqua",Palatino,Georgia,serif !important;
  font-size:18px !important;
  font-style:italic !important;
  font-weight:600 !important;
  color:#5a351d !important;
  line-height:1.18 !important;
  text-shadow:
    0 1px 0 rgba(255,238,206,.82),
    0 2px 3px rgba(65,34,16,.42),
    0 4px 8px rgba(65,34,16,.22) !important;
  z-index:40 !important;
  pointer-events:none !important;
}

.door-arrow{
  display:block !important;
  width:100% !important;
  text-align:center !important;
  font-size:20px !important;
  line-height:1 !important;
  margin-bottom:4px !important;
  color:#6f451f !important;
  text-shadow:
    0 1px 0 rgba(255,238,206,.75),
    0 2px 4px rgba(65,34,16,.35) !important;
}

@media(max-width:560px){
  .door-label{
    width:74% !important;
    bottom:2.5% !important;
    font-size:15px !important;
    line-height:1.15 !important;
  }
  .door-arrow{
    font-size:18px !important;
    margin-bottom:3px !important;
  }
}


/* TRANSIÇÃO CAPA -> VÍDEO NO MESMO LUGAR */
#videoIntro{
  margin:0 auto !important;
  padding:0 !important;
}

@media(max-width:560px){
  #videoIntro{
    width:100vw !important;
    max-width:none !important;
    margin:0 !important;
    padding:0 !important;
  }

  #videoIntro .video-frame{
    width:100vw !important;
    margin:0 !important;
    border-radius:0 !important;
    box-shadow:none !important;
  }

  #videoIntro video{
    width:100vw !important;
    height:auto !important;
    max-height:none !important;
    margin:0 !important;
    display:block !important;
  }

  #videoIntro .video-note,
  #videoIntro #skipVideoBtn{
    display:none !important;
  }
}

</style>
</head>
<body>
<div id="coverScreen" class="cover-screen">
  <div class="cover-wrap">
    <img src="capa-maite.png" alt="A Magia de Maitê - castelo encantado">
    <button id="castleDoor" class="castle-door-hotspot" type="button" aria-label="Clique na porta do Castelo para abrir o convite"></button>
    <div class="door-label">
      <span class="door-arrow">↑</span>
      Abra a porta para entrar na magia!
    </div>
</div>
</div>

<div id="videoIntro" class="video-intro" style="display:none;">
  <div class="video-frame">
    <video id="inviteVideo" controls playsinline preload="metadata">
      <source src="video-maite-sem-capa.mp4" type="video/mp4">
      Seu navegador não conseguiu reproduzir o vídeo.
    </video>
  </div>
  <p class="video-note">Ao final do vídeo, a confirmação de presença aparecerá automaticamente.</p>
  <button id="skipVideoBtn" class="btn secondary" type="button" style="max-width:420px;margin:12px auto 0;display:block;">IR PARA CONFIRMAÇÃO</button>
</div>

<div id="rsvpApp" class="hidden-app">
<div class="wrap">
<section class="hero"><h1>A Magia de</h1><div class="maite">Maitê</div><p>1 aninho • 21.11.2026 • 15:45 • Piatã</p></section>
<div class="shell"><div class="monogram">M</div><section class="card">

<div id="lookup">
<h2>Confirmação de Presença</h2>
<p class="intro">Digite o seu primeiro nome.<br>O formulário localizará seu cadastro e mostrará quem está incluído no convite.</p>
<div class="line"></div>
<div class="field"><label>Primeiro nome</label><input id="searchInput" placeholder="Digite seu primeiro nome"></div>
<div id="lookupMsg"></div>
<button class="btn" id="findBtn" type="button">LOCALIZAR MEU CONVITE</button>
</div>

<div id="rsvpSection" class="hidden">
<h2>Seu convite foi localizado ✨</h2>
<p id="summaryText" class="intro"></p>
<div class="line"></div>
<div class="party"><h3>Quem estará presente?</h3><div id="peopleList"></div></div>
<div id="limitsBox" class="limit"></div>
<div id="extrasBox"></div>
<div class="field" style="margin-top:16px"><label>Telefone para contato (opcional)</label><input id="phoneInput" inputmode="tel" placeholder="(71) 99999-9999"></div>
<div id="rsvpMsg"></div>
<button class="btn" id="confirmBtn" type="button">CONFIRMAR PRESENÇA</button>
<button class="btn secondary" id="backBtn" type="button">VOLTAR</button>
</div>

<div id="successSection" class="success hidden">
<div class="check">✓</div><h3>Confirmação registrada!</h3>
<p>Obrigada por responder.<br>Estamos esperando vocês para viver a magia da Maitê. ✨</p>
</div>

</section></div></div>
</div>

<script>

const coverScreen=document.getElementById("coverScreen");
const castleDoor=document.getElementById("castleDoor");
const videoIntro=document.getElementById("videoIntro");
const inviteVideo=document.getElementById("inviteVideo");
const rsvpApp=document.getElementById("rsvpApp");
const skipVideoBtn=document.getElementById("skipVideoBtn");

castleDoor.addEventListener("click", async ()=>{
  coverScreen.style.setProperty("opacity","0","important");
  coverScreen.style.setProperty("pointer-events","none","important");

  setTimeout(async ()=>{
    coverScreen.style.setProperty("display","none","important");
    videoIntro.style.setProperty("display","block","important");

    window.scrollTo({top:0,left:0,behavior:"auto"});

    try{
      inviteVideo.currentTime=0;
      await inviteVideo.play();
    }catch(e){
      // O player ficará visível caso o navegador exija toque manual.
    }
  },250);
});

function showRsvp(){
  videoIntro.style.display="none";
  rsvpApp.classList.remove("hidden-app");
  window.scrollTo({top:0,behavior:"smooth"});
}

inviteVideo.addEventListener("ended",showRsvp);
skipVideoBtn.addEventListener("click",showRsvp);

