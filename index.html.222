},{"id":"42","adults":["Deidiane"],"children":[],"extra_adults":2,"extra_children":0},{"id":"43","adults":["Lopes"],"children":[],"extra_adults":0,"extra_children":0},{"id":"44","adults":["Junior"],"children":[{"name":"Arthur","age":null}],"extra_adults":0,"extra_children":0},{"id":"45","adults":["Ismael"],"children":[{"name":"Isadora","age":null}],"extra_adults":0,"extra_children":0},{"id":"46","adults":["Juliete","Marcelo"],"children":[{"name":"Luísa","age":null}],"extra_adults":1,"extra_children":0},{"id":"47","adults":["Jose Cleudes"],"children":[],"extra_adults":0,"extra_children":0},{"id":"48","adults":["Anselmo"],"children":[],"extra_adults":1,"extra_children":0},{"id":"49","adults":["Carmem"],"children":[],"extra_adults":1,"extra_children":0},{"id":"51","adults":["Milena Theodorio"],"children":[],"extra_adults":0,"extra_children":0},{"id":"52","adults":["Lucas Trindade"],"children":[],"extra_adults":1,"extra_children":1},{"id":"53","adults":["Juliana Vilas Boas"],"children":[],"extra_adults":1,"extra_children":2},{"id":"54","adults":["Leandro Moitinho"],"children":[],"extra_adults":0,"extra_children":0}];
const WEB_APP_URL="https://script.google.com/macros/s/AKfycbz7pWV8PcNz-8IJcOWCxEI1lYFFhHBxMS1aK_M8xkR73ZUI3PUPVRx5AV6zeATH_O47jA/exec";
let currentFamily=null;

const lookupEl=document.getElementById("lookup");
const searchInput=document.getElementById("searchInput");
const lookupMsg=document.getElementById("lookupMsg");
const findBtn=document.getElementById("findBtn");
const rsvpSection=document.getElementById("rsvpSection");
const summaryText=document.getElementById("summaryText");
const peopleList=document.getElementById("peopleList");
const limitsBox=document.getElementById("limitsBox");
const extrasBox=document.getElementById("extrasBox");
const phoneInput=document.getElementById("phoneInput");
const rsvpMsg=document.getElementById("rsvpMsg");
const confirmBtn=document.getElementById("confirmBtn");
const backBtn=document.getElementById("backBtn");
const successSection=document.getElementById("successSection");

const norm=s=>(s||"").normalize("NFD").replace(/[\u0300-\u036f]/g,"").toLowerCase().replace(/[^a-z0-9 ]/g," ").replace(/\s+/g," ").trim();
const first=s=>norm(s).split(" ")[0]||"";
const esc=s=>String(s).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));

function allPeople(f){
  return [...f.adults, ...f.children.map(c=>c.name)];
}

function findMatches(value){
  const n=norm(value);
  if(!n) return [];
  const byFull=families.filter(f=>allPeople(f).some(p=>norm(p)===n));
  if(byFull.length===1) return byFull;
  const nFirst=first(value);
  return families.filter(f=>allPeople(f).some(p=>first(p)===nFirst));
}

findBtn.addEventListener("click",()=>{
  lookupMsg.innerHTML="";
  const value=searchInput.value.trim();
  if(!value){
    lookupMsg.innerHTML='<div class="msg error">Digite seu primeiro nome para localizar o convite.</div>';
    return;
  }
  const m=findMatches(value);
  if(!m.length){
    lookupMsg.innerHTML='<div class="msg error">Não encontrei esse nome na lista. Confira a grafia e tente novamente.</div>';
    return;
  }
  if(m.length>1){
    lookupMsg.innerHTML='<div class="msg error">Há mais de uma pessoa com esse primeiro nome. Digite o nome completo como consta no cadastro.</div>';
    return;
  }
  currentFamily=m[0];
  openFamily(currentFamily);
});

searchInput.addEventListener("keydown",(e)=>{
  if(e.key==="Enter") findBtn.click();
});

function openFamily(f){
  lookupEl.classList.add("hidden");
  rsvpSection.classList.remove("hidden");
  successSection.classList.add("hidden");

  const total=f.adults.length+f.children.length;
  const extras=f.extra_adults+f.extra_children;
  summaryText.textContent=`Encontramos seu convite: ${total} pessoa(s) nominada(s)${extras?` e até ${extras} vaga(s) adicional(is).`:", sem vagas adicionais."}`;

  let h="";
  f.adults.forEach(p=>{
    h+=`<div class="person"><div class="head"><input type="checkbox" class="named adult" data-name="${esc(p)}" checked><span>${esc(p)}</span><span class="badge">Adulto</span></div></div>`;
  });
  f.children.forEach((c,i)=>{
    h+=`<div class="person"><div class="head"><input type="checkbox" class="named child" data-name="${esc(c.name)}" data-i="${i}" checked><span>${esc(c.name)}</span><span class="badge">Criança</span></div><div class="age"><label>Idade de ${esc(c.name)}</label><input class="childAge" data-i="${i}" type="number" min="0" max="17" inputmode="numeric" placeholder="Idade em anos"></div></div>`;
  });
  peopleList.innerHTML=h;

  const parts=[];
  if(f.extra_adults) parts.push(`${f.extra_adults} adulto(s) adicional(is)`);
  if(f.extra_children) parts.push(`${f.extra_children} criança(s) adicional(is)`);
  limitsBox.innerHTML=parts.length
    ? `<strong>Limite do seu convite</strong><br>Além dos nomes acima, seu convite permite no máximo: <strong>${parts.join(" + ")}</strong>.`
    : `<strong>Limite do seu convite</strong><br>Este convite não possui acompanhantes adicionais.`;

  buildExtras(f);
}

function buildExtras(f){
  let h="";
  if(f.extra_adults){
    h+=`<div class="field"><label>Quantos adultos adicionais irão?</label><select id="extraAdults">${[...Array(f.extra_adults+1)].map((_,i)=>`<option value="${i}">${i}</option>`).join("")}</select></div><div id="adultNames"></div>`;
  }
  if(f.extra_children){
    h+=`<div class="field"><label>Quantas crianças adicionais irão?</label><select id="extraChildren">${[...Array(f.extra_children+1)].map((_,i)=>`<option value="${i}">${i}</option>`).join("")}</select></div><div id="childNames"></div>`;
  }
  extrasBox.innerHTML=h;

  const extraAdults=document.getElementById("extraAdults");
  const adultNames=document.getElementById("adultNames");
  if(extraAdults){
    extraAdults.addEventListener("change",()=>{
      adultNames.innerHTML=[...Array(Number(extraAdults.value))].map((_,i)=>`<div class="field"><label>Nome do adulto adicional ${i+1}</label><input class="adultExtra" placeholder="Nome completo"></div>`).join("");
    });
  }

  const extraChildren=document.getElementById("extraChildren");
  const childNames=document.getElementById("childNames");
  if(extraChildren){
    extraChildren.addEventListener("change",()=>{
      childNames.innerHTML=[...Array(Number(extraChildren.value))].map((_,i)=>`<div class="field"><label>Criança adicional ${i+1}</label><div class="two"><input class="childExtraName" placeholder="Nome da criança"><input class="childExtraAge" type="number" min="0" max="17" placeholder="Idade"></div></div>`).join("");
    });
  }
}

backBtn.addEventListener("click",()=>{
  currentFamily=null;
  rsvpSection.classList.add("hidden");
  lookupEl.classList.remove("hidden");
  rsvpMsg.innerHTML="";
});

confirmBtn.addEventListener("click",async()=>{
  rsvpMsg.innerHTML="";
  let missing="";
  const namedChildren=[];

  document.querySelectorAll(".child").forEach(cb=>{
    if(cb.checked){
      const ageEl=document.querySelector(`.childAge[data-i="${cb.dataset.i}"]`);
      const age=ageEl ? ageEl.value.trim() : "";
      if(!age && !missing) missing=cb.dataset.name;
      else if(age) namedChildren.push({name:cb.dataset.name,age:Number(age)});
    }
  });

  if(missing){
    rsvpMsg.innerHTML=`<div class="msg error">Informe a idade da criança ${missing}.</div>`;
    return;
  }

  const adultExtra=[...document.querySelectorAll(".adultExtra")].map(x=>x.value.trim());
  if(adultExtra.some(x=>!x)){
    rsvpMsg.innerHTML='<div class="msg error">Preencha o nome de todos os adultos adicionais.</div>';
    return;
  }

  const childNames=[...document.querySelectorAll(".childExtraName")];
  const childAges=[...document.querySelectorAll(".childExtraAge")];
  const childExtra=[];

  for(let i=0;i<childNames.length;i++){
    const name=childNames[i].value.trim();
    const age=childAges[i].value.trim();
    if(!name || !age){
      rsvpMsg.innerHTML='<div class="msg error">Preencha nome e idade de todas as crianças adicionais.</div>';
      return;
    }
    childExtra.push({name,age:Number(age)});
  }

  const record={
    family_id:currentFamily.id,
    convidados_nominados_presentes:[...document.querySelectorAll(".named:checked")].map(x=>x.dataset.name),
    criancas_nominadas_presentes:namedChildren,
    adultos_adicionais:adultExtra,
    criancas_adicionais:childExtra,
    telefone:phoneInput.value.trim(),
    registrado_em:new Date().toISOString()
  };

  confirmBtn.disabled=true;
  confirmBtn.textContent="ENVIANDO CONFIRMAÇÃO...";

  try {
    await fetch(WEB_APP_URL, {
      method:"POST",
      mode:"no-cors",
      headers:{"Content-Type":"text/plain;charset=utf-8"},
      body:JSON.stringify(record)
    });

    const saved=JSON.parse(localStorage.getItem("rsvp_maite")||"[]");
    saved.push(record);
    localStorage.setItem("rsvp_maite",JSON.stringify(saved));

    rsvpSection.classList.add("hidden");
    successSection.classList.remove("hidden");
  } catch (erro) {
    rsvpMsg.innerHTML='<div class="msg error">Não foi possível enviar a confirmação. Verifique sua internet e tente novamente.</div>';
    confirmBtn.disabled=false;
    confirmBtn.textContent="CONFIRMAR PRESENÇA";
  }
});
</script>
</body>
</html>
